  <!-- SCRIPT LOGIKA & AUDIO SYNTHESIZER -->
  <script>
    /**
     * SISTEM AUDIO MENEGANGKAN (WEB AUDIO API SYNTHESIZER)
     * Tanpa ketergantungan file MP3 luar untuk memastikan 100% reliabilitas offline!
     */
    class SuspenseAudioEngine {
      constructor() {
        this.ctx = null;
        this.isMuted = false;
        this.bgmTimer = null;
        this.droneOsc = null;
        this.droneGain = null;
      }

      initContext() {
        if (!this.ctx) {
          const AudioContextClass = window.AudioContext || window.webkitAudioContext;
          this.ctx = new AudioContextClass();
        }
        if (this.ctx.state === 'suspended') {
          this.ctx.resume();
        }
      }

      toggleMute() {
        this.isMuted = !this.isMuted;
        if (this.isMuted) {
          this.stopBGM();
        }
        return !this.isMuted;
      }

      // Suara detak jantung / kick drum menegangkan
      playHeartbeat(frequency = 60, intensity = 0.5) {
        if (this.isMuted) return;
        this.initContext();

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();
        const now = this.ctx.currentTime;

        osc.type = 'sine';
        osc.frequency.setValueAtTime(frequency, now);
        osc.frequency.exponentialRampToValueAtTime(25, now + 0.12);

        gain.gain.setValueAtTime(intensity, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + 0.18);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + 0.2);
      }

      // Suara swoosh / transisi angka baru (ketegangan meningkat)
      playTickTransition(isAddition = true) {
        if (this.isMuted) return;
        this.initContext();

        const now = this.ctx.currentTime;
        // Frekuensi lebih ceria untuk +, lebih tajam untuk -
        const baseFreq = isAddition ? 440 : 330;

        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'triangle';
        osc.frequency.setValueAtTime(baseFreq, now);
        osc.frequency.exponentialRampToValueAtTime(baseFreq * 1.5, now + 0.08);

        gain.gain.setValueAtTime(0.3, now);
        gain.gain.exponentialRampToValueAtTime(0.01, now + 0.1);

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + 0.12);

        // Tambah detak jantung bersamaan
        this.playHeartbeat(75, 0.4);
      }

      // Countdown beep
      playCountdownBeep(isFinal = false) {
        if (this.isMuted) return;
        this.initContext();

        const now = this.ctx.currentTime;
        const osc = this.ctx.createOscillator();
        const gain = this.ctx.createGain();

        osc.type = 'sine';
        osc.frequency.setValueAtTime(isFinal ? 880 : 440, now);

        gain.gain.setValueAtTime(0.4, now);
        gain.gain.exponentialRampToValueAtTime(0.001, now + (isFinal ? 0.35 : 0.15));

        osc.connect(gain);
        gain.connect(this.ctx.destination);

        osc.start(now);
        osc.stop(now + (isFinal ? 0.4 : 0.2));
      }

      // Mulai drone suara bass menegangkan di latar belakang
      startTenseLoop() {
        if (this.isMuted) return;
        this.initContext();
        this.stopBGM();

        // Buat drone bergelombang menegangkan
        const now = this.ctx.currentTime;
        this.droneOsc = this.ctx.createOscillator();
        this.droneGain = this.ctx.createGain();

        this.droneOsc.type = 'sawtooth';
        this.droneOsc.frequency.setValueAtTime(55, now); // Nada A1 dalam

        // Filter suara agar gelap/menegangkan (low-pass)
        const filter = this.ctx.createBiquadFilter();
        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(140, now);

        this.droneGain.gain.setValueAtTime(0.08, now);

        this.droneOsc.connect(filter);
        filter.connect(this.droneGain);
        this.droneGain.connect(this.ctx.destination);

        this.droneOsc.start();

        // Loop detak jantung ganda (lub-dub suspense)
        this.bgmTimer = setInterval(() => {
          if (this.isMuted) return;
          this.playHeartbeat(55, 0.35);
          setTimeout(() => {
            this.playHeartbeat(45, 0.25);
          }, 140);
        }, 900);
      }

      stopBGM() {
        if (this.bgmTimer) {
          clearInterval(this.bgmTimer);
          this.bgmTimer = null;
        }
        if (this.droneOsc) {
          try {
            this.droneGain.gain.exponentialRampToValueAtTime(0.001, this.ctx.currentTime + 0.1);
            this.droneOsc.stop(this.ctx.currentTime + 0.12);
          } catch(e) {}
          this.droneOsc = null;
        }
      }

      // Fanfare kemenangan saat kunci jawaban dibuka
      playFanfare() {
        if (this.isMuted) return;
        this.initContext();

        const notes = [523.25, 659.25, 783.99, 1046.50]; // C5, E5, G5, C6
        notes.forEach((freq, idx) => {
          const now = this.ctx.currentTime + (idx * 0.09);
          const osc = this.ctx.createOscillator();
          const gain = this.ctx.createGain();

          osc.type = 'triangle';
          osc.frequency.setValueAtTime(freq, now);

          gain.gain.setValueAtTime(0.25, now);
          gain.gain.exponentialRampToValueAtTime(0.001, now + 0.4);

          osc.connect(gain);
          gain.connect(this.ctx.destination);

          osc.start(now);
          osc.stop(now + 0.45);
        });
      }
    }

    /**
     * ENGINE LOGIKA JARIMATIKA
     * Disesuaikan khusus untuk tingkatan dasar SD:
     * Level 1: Satuan murni 1-9 (Hanya tangan kanan, tanpa kawan)
     * Level 2: Kawan kecil 5 (Tangan kanan)
     * Level 3: Transisi belasan 1-20 (Mulai gunakan tangan kiri bernilai 10)
     * Level 4: Puluhan ceria SD (Hasil 10-50)
     */
    class JarimatikaExerciseGenerator {
      /**
       * Menghasilkan rentetan operasi matematis ramah siswa SD
       * @param {number} level 1 s.d 4
       * @param {number} totalSteps Jumlah angka ditampilkan
       */
      static generate(level, totalSteps = 4) {
        let attempts = 0;
        const maxAttempts = 120;

        while (attempts < maxAttempts) {
          attempts++;
          const sequence = [];
          
          let initial = 0;
          let minBound = 1;
          let maxBound = 9;

          if (level === 1) {
            // Level 1: Satuan Murni (1 - 9)
            initial = this.getRandomInt(1, 4);
            minBound = 1;
            maxBound = 9;
          } else if (level === 2) {
            // Level 2: Kawan Kecil (1 - 9)
            initial = this.getRandomInt(2, 4);
            minBound = 1;
            maxBound = 9;
          } else if (level === 3) {
            // Level 3: Menuju Belasan (1 - 20)
            initial = this.getRandomInt(5, 12);
            minBound = 1;
            maxBound = 20;
          } else {
            // Level 4: Puluhan Pemula (10 - 50)
            initial = this.getRandomInt(12, 30);
            minBound = 10;
            maxBound = 50;
          }

          let currentTotal = initial;
          sequence.push({
            op: '+',
            value: initial,
            subtotal: currentTotal,
            note: 'Angka Awal'
          });

          let valid = true;

          for (let i = 1; i < totalSteps; i++) {
            let canAdd = currentTotal < (maxBound - 1);
            let canSub = currentTotal > (minBound + 1);

            let isAddition = canAdd && canSub ? (Math.random() > 0.45) : canAdd;
            let stepVal = 0;

            if (level === 1) {
              // Level 1: Tambah/kurang langsung (1-3)
              stepVal = isAddition ? this.getRandomInt(1, Math.min(3, maxBound - currentTotal)) : this.getRandomInt(1, Math.min(3, currentTotal - minBound));
            } else if (level === 2) {
              // Level 2: Melibatkan kawan 5
              stepVal = isAddition ? this.getRandomInt(2, Math.min(4, maxBound - currentTotal)) : this.getRandomInt(2, Math.min(4, currentTotal - minBound));
            } else if (level === 3) {
              // Level 3: Melibatkan loncatan kawan 10
              stepVal = isAddition ? this.getRandomInt(2, Math.min(7, maxBound - currentTotal)) : this.getRandomInt(2, Math.min(6, currentTotal - minBound));
            } else {
              // Level 4: Puluhan kecil SD
              stepVal = isAddition ? this.getRandomInt(5, Math.min(15, maxBound - currentTotal)) : this.getRandomInt(5, Math.min(15, currentTotal - minBound));
            }

            if (!stepVal || stepVal <= 0) {
              valid = false;
              break;
            }

            if (isAddition) {
              currentTotal += stepVal;
            } else {
              currentTotal -= stepVal;
            }

            if (currentTotal < minBound || currentTotal > maxBound) {
              valid = false;
              break;
            }

            sequence.push({
              op: isAddition ? '+' : '-',
              value: stepVal,
              subtotal: currentTotal
            });
          }

          if (valid && sequence.length === totalSteps) {
            return {
              sequence,
              finalTotal: currentTotal
            };
          }
        }

        // Fallback aman ramah SD
        return {
          sequence: [
            { op: '+', value: 3, subtotal: 3 },
            { op: '+', value: 4, subtotal: 7 },
            { op: '-', value: 2, subtotal: 5 },
            { op: '+', value: 3, subtotal: 8 }
          ],
          finalTotal: 8
        };
      }

      static getRandomInt(min, max) {
        if (min > max) return min;
        return Math.floor(Math.random() * (max - min + 1)) + min;
      }

      /**
       * Menerjemahkan angka ke deskripsi posisi jari Jarimatika SD & array visual jari
       */
      static describeJarimatikaFormation(number) {
        const tens = Math.floor(number / 10);
        const units = number % 10;

        let leftDesc = "";
        let rightDesc = "";

        // Status jari tangan kiri: [kelingking, manis, tengah, telunjuk, jempol]
        let leftFingers = {
          pinky: tens >= 4,
          ring: tens >= 3,
          middle: tens >= 2,
          index: tens >= 1 && (tens < 5 || tens % 5 >= 1),
          thumb: tens >= 5
        };

        // Status jari tangan kanan: [jempol, telunjuk, tengah, manis, kelingking]
        let rightFingers = {
          thumb: units >= 5,
          index: (units % 5) >= 1,
          middle: (units % 5) >= 2,
          ring: (units % 5) >= 3,
          pinky: (units % 5) >= 4
        };

        // Deskripsi Tangan Kiri (Puluhan)
        if (tens === 0) {
          leftDesc = "Tangan Kiri Tertutup Rapat (0)";
        } else if (tens >= 5) {
          const rem = tens - 5;
          leftDesc = `Jempol Kiri (50)${rem > 0 ? ` + ${rem} Jari Biasa (${rem * 10})` : ''}`;
        } else {
          leftDesc = `Buka ${tens} Jari Biasa (${tens * 10})`;
        }

        // Deskripsi Tangan Kanan (Satuan)
        if (units === 0) {
          rightDesc = "Tangan Kanan Tertutup Rapat (0)";
        } else if (units >= 5) {
          const rem = units - 5;
          rightDesc = `Jempol Kanan (5)${rem > 0 ? ` + ${rem} Jari Biasa (${rem})` : ''}`;
        } else {
          rightDesc = `Buka ${units} Jari Biasa (${units})`;
        }

        return { leftDesc, rightDesc, leftFingers, rightFingers };
      }
    }

    /**
     * PENGONTROL APLIKASI UTAMA (STATE & DOM)
     */
    document.addEventListener('DOMContentLoaded', () => {
      const audio = new SuspenseAudioEngine();

      // Referensi Elemen UI
      const btnStart = document.getElementById('btnStart');
      const btnStop = document.getElementById('btnStop');
      const btnReveal = document.getElementById('btnReveal');
      const btnRetry = document.getElementById('btnRetry');
      const btnNextRound = document.getElementById('btnNextRound');
      const btnToggleBreakdown = document.getElementById('btnToggleBreakdown');
      const btnAudio = document.getElementById('btnAudio');
      const btnFullscreen = document.getElementById('btnFullscreen');
      const btnGuide = document.getElementById('btnGuide');
      const btnCloseGuide = document.getElementById('btnCloseGuide');
      const btnUnderstand = document.getElementById('btnUnderstand');

      const selectLevel = document.getElementById('selectLevel');
      const selectSpeed = document.getElementById('selectSpeed');
      const selectSteps = document.getElementById('selectSteps');

      const screenIdle = document.getElementById('screenIdle');
      const screenCountdown = document.getElementById('screenCountdown');
      const screenFlash = document.getElementById('screenFlash');
      const screenAnswering = document.getElementById('screenAnswering');
      const screenResult = document.getElementById('screenResult');

      const countdownNumber = document.getElementById('countdownNumber');
      const displaySign = document.getElementById('displaySign');
      const displayValue = document.getElementById('displayValue');
      const subHint = document.getElementById('subHint');

      const badgeStatus = document.getElementById('badgeStatus');
      const stepCounterText = document.getElementById('stepCounterText');
      const stepTimerBar = document.getElementById('stepTimerBar');

      const finalAnswerValue = document.getElementById('finalAnswerValue');
      const descLeftHand = document.getElementById('descLeftHand');
      const descRightHand = document.getElementById('descRightHand');
      const breakdownPanel = document.getElementById('breakdownPanel');
      const breakdownList = document.getElementById('breakdownList');

      const visualLeftHand = document.getElementById('visualLeftHand');
      const visualRightHand = document.getElementById('visualRightHand');

      const iconAudioOn = document.getElementById('iconAudioOn');
      const iconAudioOff = document.getElementById('iconAudioOff');
      const labelAudio = document.getElementById('labelAudio');

      // State Latihan
      let currentExercise = null;
      let currentStepIndex = 0;
      let timerInterval = null;
      let stepTimeout = null;
      let isRunning = false;

      // Sembunyikan semua layar
      function hideAllScreens() {
        screenIdle.classList.add('hidden');
        screenCountdown.classList.add('hidden');
        screenFlash.classList.add('hidden');
        screenAnswering.classList.add('hidden');
        screenResult.classList.add('hidden');
      }

      // Update Tampilan Status Badge
      function setStatus(text, colorClass = 'bg-slate-200 text-slate-700') {
        badgeStatus.className = `inline-flex items-center gap-1.5 px-3 py-1 rounded-full font-bold text-xs ${colorClass}`;
        badgeStatus.innerHTML = `<span class="w-2 h-2 rounded-full bg-current"></span> ${text}`;
      }

      // Mulai Rangkaian Sesi
      function startSession(reuseExisting = false) {
        if (!reuseExisting || !currentExercise) {
          const level = parseInt(selectLevel.value, 10);
          const steps = parseInt(selectSteps.value, 10);
          currentExercise = JarimatikaExerciseGenerator.generate(level, steps);
        }

        currentStepIndex = 0;
        isRunning = true;
        btnStop.disabled = false;
        breakdownPanel.classList.add('hidden');

        hideAllScreens();
        screenCountdown.classList.remove('hidden');
        setStatus("Hitung Mundur Mulai...", "bg-amber-100 text-amber-800");

        // Countdown 3, 2, 1
        let count = 3;
        countdownNumber.textContent = count;
        audio.playCountdownBeep(false);

        const cdInterval = setInterval(() => {
          count--;
          if (count > 0) {
            countdownNumber.textContent = count;
            audio.playCountdownBeep(false);
          } else {
            clearInterval(cdInterval);
            countdownNumber.textContent = "GO!";
            audio.playCountdownBeep(true);
            setTimeout(() => {
              startExerciseFlashing();
            }, 500);
          }
        }, 1000);
      }

      // Menjalankan Flash Pergantian Angka
      function startExerciseFlashing() {
        hideAllScreens();
        screenFlash.classList.remove('hidden');
        setStatus("Perhatikan Layar & Gerakkan Jari!", "bg-rose-100 text-rose-700 animate-pulse");

        // Mulai audio ketegangan
        audio.startTenseLoop();

        const speed = parseInt(selectSpeed.value, 10);
        const total = currentExercise.sequence.length;

        function showNextStep() {
          if (!isRunning) return;

          if (currentStepIndex >= total) {
            // Selesai semua langkah -> Pindah ke mode tunggu jawaban
            finishFlashing();
            return;
          }

          const stepData = currentExercise.sequence[currentStepIndex];
          stepCounterText.textContent = `${currentStepIndex + 1} / ${total}`;

          // Format Tampilan Simbol dan Warna
          if (currentStepIndex === 0) {
            displaySign.textContent = '';
            displaySign.className = 'hidden';
            displayValue.className = 'text-8xl md:text-9xl lg:text-[11rem] font-black tracking-tight font-display text-indigo-600 animate-pop-in drop-shadow-sm';
            subHint.textContent = "Bentuk angka awal ini di kedua tangan!";
            subHint.className = 'mt-2 px-4 py-1.5 rounded-full bg-indigo-50 text-indigo-700 text-xs md:text-sm font-bold border border-indigo-200';
            audio.playTickTransition(true);
          } else {
            displaySign.classList.remove('hidden');
            if (stepData.op === '+') {
              displaySign.textContent = '+';
              displaySign.className = 'text-6xl md:text-8xl lg:text-9xl font-black font-display text-emerald-500';
              displayValue.className = 'text-8xl md:text-9xl lg:text-[11rem] font-black tracking-tight font-display text-emerald-600 animate-pop-in drop-shadow-sm';
              subHint.textContent = `TAMBAH ${stepData.value}: Buka jari sesuai rumus kawan!`;
              subHint.className = 'mt-2 px-4 py-1.5 rounded-full bg-emerald-50 text-emerald-700 text-xs md:text-sm font-bold border border-emerald-200';
              audio.playTickTransition(true);
            } else {
              displaySign.textContent = '-';
              displaySign.className = 'text-6xl md:text-8xl lg:text-9xl font-black font-display text-rose-500';
              displayValue.className = 'text-8xl md:text-9xl lg:text-[11rem] font-black tracking-tight font-display text-rose-600 animate-pop-in drop-shadow-sm';
              subHint.textContent = `KURANG ${stepData.value}: Lipat/tutup jari sesuai rumus kawan!`;
              subHint.className = 'mt-2 px-4 py-1.5 rounded-full bg-rose-50 text-rose-700 text-xs md:text-sm font-bold border border-rose-200';
              audio.playTickTransition(false);
            }
          }

          displayValue.textContent = stepData.value;

          // Animasi Timer Bar
          stepTimerBar.style.transition = 'none';
          stepTimerBar.style.width = '100%';
          setTimeout(() => {
            stepTimerBar.style.transition = `width ${speed}ms linear`;
            stepTimerBar.style.width = '0%';
          }, 30);

          currentStepIndex++;
          stepTimeout = setTimeout(showNextStep, speed);
        }

        showNextStep();
      }

      // Selesai Flash -> Mode Tunggu Kunci Jawaban
      function finishFlashing() {
        audio.stopBGM();
        hideAllScreens();
        screenAnswering.classList.remove('hidden');
        setStatus("Selesai! Berapa Angka di Jarimu?", "bg-amber-100 text-amber-800");
        stepTimerBar.style.width = '0%';
      }

      // Helper Renderer Kartun Jari SD
      function renderVisualHand(container, fingersObj, isRightHand = true) {
        container.innerHTML = '';

        // Tangan Kiri: Kelingking (10), Manis (10), Tengah (10), Telunjuk (10), Jempol (50)
        // Tangan Kanan: Jempol (5), Telunjuk (1), Tengah (1), Manis (1), Kelingking (1)
        const fingers = isRightHand ? [
          { key: 'thumb', label: 'J (5)', height: 'h-10', baseW: 'w-4', color: 'bg-amber-400' },
          { key: 'index', label: '1', height: 'h-14', baseW: 'w-3.5', color: 'bg-rose-400' },
          { key: 'middle', label: '1', height: 'h-16', baseW: 'w-3.5', color: 'bg-rose-400' },
          { key: 'ring', label: '1', height: 'h-14', baseW: 'w-3.5', color: 'bg-rose-400' },
          { key: 'pinky', label: '1', height: 'h-11', baseW: 'w-3', color: 'bg-rose-400' },
        ] : [
          { key: 'pinky', label: '10', height: 'h-11', baseW: 'w-3', color: 'bg-indigo-400' },
          { key: 'ring', label: '10', height: 'h-14', baseW: 'w-3.5', color: 'bg-indigo-400' },
          { key: 'middle', label: '10', height: 'h-16', baseW: 'w-3.5', color: 'bg-indigo-400' },
          { key: 'index', label: '10', height: 'h-14', baseW: 'w-3.5', color: 'bg-indigo-400' },
          { key: 'thumb', label: 'J (50)', height: 'h-10', baseW: 'w-4', color: 'bg-amber-400' },
        ];

        fingers.forEach(f => {
          const isOpen = fingersObj[f.key];
          const fingerEl = document.createElement('div');
          fingerEl.className = 'flex flex-col items-center justify-end';

          fingerEl.innerHTML = `
            <div class="${f.baseW} ${isOpen ? f.height + ' ' + f.color + ' shadow-md ring-2 ring-emerald-400' : 'h-4 bg-slate-300'} rounded-t-full transition-all duration-300 flex items-start justify-center">
              ${isOpen ? '<span class="text-[8px] text-white font-black mt-0.5">•</span>' : ''}
            </div>
            <span class="text-[9px] font-black ${isOpen ? 'text-slate-800' : 'text-slate-400'} mt-1">${f.label}</span>
          `;
          container.appendChild(fingerEl);
        });
      }

      // Buka Kunci Jawaban & Tampilkan Hasil
      function revealAnswer() {
        audio.stopBGM();
        audio.playFanfare();
        hideAllScreens();
        screenResult.classList.remove('hidden');
        setStatus("Kunci Jawaban Terbuka", "bg-emerald-100 text-emerald-800");

        const ans = currentExercise.finalTotal;
        finalAnswerValue.textContent = ans;

        // Analisis formasi jari & generate visual kartun
        const formation = JarimatikaExerciseGenerator.describeJarimatikaFormation(ans);
        descLeftHand.textContent = formation.leftDesc;
        descRightHand.textContent = formation.rightDesc;

        // Render kartun jari di layar proyektor
        renderVisualHand(visualLeftHand, formation.leftFingers, false);
        renderVisualHand(visualRightHand, formation.rightFingers, true);

        // Siapkan panel riwayat
        populateBreakdown();
      }

      // Isi Panel Breakdown untuk crosscheck guru
      function populateBreakdown() {
        breakdownList.innerHTML = '';
        currentExercise.sequence.forEach((item, idx) => {
          const badge = document.createElement('div');
          const isPlus = item.op === '+';
          badge.className = `px-3 py-1.5 rounded-xl text-xs font-bold border flex items-center gap-1 ${
            idx === 0 
              ? 'bg-indigo-50 text-indigo-700 border-indigo-200' 
              : isPlus 
                ? 'bg-emerald-50 text-emerald-700 border-emerald-200' 
                : 'bg-rose-50 text-rose-700 border-rose-200'
          }`;
          badge.innerHTML = `
            <span>${idx === 0 ? 'Mulai:' : item.op}</span>
            <span class="text-sm font-black">${item.value}</span>
            <span class="text-slate-400 font-normal">(&rarr; ${item.subtotal})</span>
          `;
          breakdownList.appendChild(badge);
        });

        // Hasil akhir badge
        const totalBadge = document.createElement('div');
        totalBadge.className = 'px-3.5 py-1.5 rounded-xl text-xs font-black bg-slate-900 text-white shadow-sm';
        totalBadge.innerHTML = `= ${currentExercise.finalTotal}`;
        breakdownList.appendChild(totalBadge);
      }

      // Reset ke Kondisi Awal
      function resetSession() {
        isRunning = false;
        clearTimeout(stepTimeout);
        clearInterval(timerInterval);
        audio.stopBGM();

        btnStop.disabled = true;
        hideAllScreens();
        screenIdle.classList.remove('hidden');
        setStatus("Siap Memulai", "bg-slate-200 text-slate-700");
        stepTimerBar.style.width = '0%';
        stepCounterText.textContent = `0 / ${selectSteps.value}`;
        breakdownPanel.classList.add('hidden');
      }

      // EVENT LISTENERS
      btnStart.addEventListener('click', () => startSession(false));
      btnStop.addEventListener('click', resetSession);
      btnReveal.addEventListener('click', revealAnswer);
      btnRetry.addEventListener('click', () => startSession(true));
      btnNextRound.addEventListener('click', () => startSession(false));

      btnToggleBreakdown.addEventListener('click', () => {
        breakdownPanel.classList.toggle('hidden');
      });

      // Kontrol Audio
      btnAudio.addEventListener('click', () => {
        const isNowOn = audio.toggleMute();
        if (isNowOn) {
          iconAudioOn.classList.remove('hidden');
          iconAudioOff.classList.add('hidden');
          labelAudio.textContent = 'BGM & SFX: Nyala';
          btnAudio.className = 'px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm';
        } else {
          iconAudioOn.classList.add('hidden');
          iconAudioOff.classList.remove('hidden');
          labelAudio.textContent = 'Suara: Hening';
          btnAudio.className = 'px-3.5 py-2 bg-slate-100 hover:bg-slate-200 text-slate-500 border border-slate-200 text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm';
        }
      });

      // Fullscreen Proyektor
      btnFullscreen.addEventListener('click', () => {
        if (!document.fullscreenElement) {
          document.documentElement.requestFullscreen().catch(() => {});
        } else {
          document.exitFullscreen().catch(() => {});
        }
      });

      // Modal Panduan
      btnGuide.addEventListener('click', () => modalGuide.classList.remove('hidden'));
      btnCloseGuide.addEventListener('click', () => modalGuide.classList.add('hidden'));
      btnUnderstand.addEventListener('click', () => modalGuide.classList.add('hidden'));

      // Sinkronisasi info total saat jumlah baris diubah
      selectSteps.addEventListener('change', () => {
        if (!isRunning) {
          stepCounterText.textContent = `0 / ${selectSteps.value}`;
        }
      });

      // Shortcut Keyboard untuk Guru / Presenter Proyektor
      window.addEventListener('keydown', (e) => {
        if (e.code === 'Space') {
          // Tombol Spasi: Mulai / Buka Kunci Jawaban
          e.preventDefault();
          if (!isRunning && !screenAnswering.classList.contains('hidden')) {
            revealAnswer();
          } else if (screenIdle.classList.contains('hidden') === false) {
            startSession(false);
          }
        } else if (e.code === 'KeyR') {
          // Tombol R: Reset
          resetSession();
        } else if (e.code === 'KeyM') {
          // Tombol M: Mute
          btnAudio.click();
        }
      });
    });
  </script>
</body>
</html>
