<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Flash Jarimatika SD Ceria - Mental Aritmatika Proyektor</title>
  
  <!-- Tailwind CSS via CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- Google Fonts: Plus Jakarta Sans & Fredoka -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fredoka:wght@500;600;700&family=Plus+Jakarta+Sans:wght@400;600;700;800;900&display=swap" rel="stylesheet">
  
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'sans-serif'],
            display: ['"Fredoka"', 'sans-serif'],
          },
          colors: {
            pastel: {
              lavender: '#E0E7FF',
              purple: '#818CF8',
              deepPurple: '#4F46E5',
              mint: '#D1FAE5',
              emerald: '#10B981',
              peach: '#FFE4E6',
              rose: '#F43F5E',
              lemon: '#FEF3C7',
              amber: '#D97706',
              sky: '#E0F2FE',
              blue: '#0284C7'
            }
          },
          animation: {
            'pop-in': 'popIn 0.35s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards',
            'pulse-fast': 'pulse 0.7s cubic-bezier(0.4, 0, 0.6, 1) infinite',
            'bounce-soft': 'bounceSoft 2s infinite',
          },
          keyframes: {
            popIn: {
              '0%': { transform: 'scale(0.65)', opacity: '0' },
              '70%': { transform: 'scale(1.08)' },
              '100%': { transform: 'scale(1)', opacity: '1' }
            },
            bounceSoft: {
              '0%, 100%': { transform: 'translateY(0)' },
              '50%': { transform: 'translateY(-6px)' }
            }
          }
        }
      }
    }
  </script>

  <style>
    /* Styling scrollbar halus untuk panel review */
    ::-webkit-scrollbar {
      width: 8px;
      height: 8px;
    }
    ::-webkit-scrollbar-track {
      background: #F3F4F6;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb {
      background: #CBD5E1;
      border-radius: 9999px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: #94A3B8;
    }
  </style>
</head>
<body class="bg-gradient-to-br from-indigo-50 via-rose-50 to-emerald-50 min-h-screen text-slate-800 font-sans flex flex-col justify-between overflow-x-hidden selection:bg-indigo-200">

  <!-- HEADER UTAMA (Optimalkan untuk Proyektor) -->
  <header class="w-full bg-white/80 backdrop-blur-md border-b border-indigo-100 shadow-sm px-6 py-3.5 z-20">
    <div class="max-w-7xl mx-auto flex flex-wrap items-center justify-between gap-4">
      
      <!-- Brand & Identitas Guru -->
      <div class="flex items-center gap-3">
        <div class="w-12 h-12 rounded-2xl bg-gradient-to-tr from-indigo-500 to-rose-400 flex items-center justify-center text-white shadow-md shadow-indigo-200">
          <!-- Ikon Dua Tangan Jarimatika -->
          <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 11.5V14m0-2.5v-6a1.5 1.5 0 113 0m-3 6a1.5 1.5 0 00-3 0v2a7.5 7.5 0 0015 0v-5a1.5 1.5 0 00-3 0m-6-3V11m0-5.5v-1a1.5 1.5 0 013 0v1m0 0V11m0-5.5a1.5 1.5 0 013 0v3m0 0V11" />
          </svg>
        </div>
        <div>
          <h1 class="text-xl md:text-2xl font-black tracking-tight text-slate-800 font-display flex items-center gap-2">
            JARIMATIKA <span class="text-xs bg-amber-500 text-white px-2.5 py-0.5 rounded-full uppercase tracking-wider font-sans font-bold shadow-sm">Tingkat SD / MI</span>
          </h1>
          <p class="text-xs text-slate-500 font-medium">
            Pelatih Mental Aritmatika &bull; <span class="text-indigo-600 font-semibold">Rahmat Djafar, S.Pd., Gr.</span>
          </p>
        </div>
      </div>

      <!-- Indikator & Tombol Audio / Layar Penuh -->
      <div class="flex items-center gap-2.5">
        <!-- Panduan Jarimatika Modal Button -->
        <button id="btnGuide" class="px-3.5 py-2 bg-pastel-lavender/60 hover:bg-pastel-lavender text-indigo-700 text-xs font-bold rounded-xl transition flex items-center gap-1.5 border border-indigo-200">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
          <span class="hidden sm:inline">Konsep Jarimatika</span>
        </button>

        <!-- Audio Toggle (BGM Tegang & SFX) -->
        <button id="btnAudio" class="px-3.5 py-2 bg-rose-50 hover:bg-rose-100 text-rose-600 border border-rose-200 text-xs font-bold rounded-xl transition flex items-center gap-1.5 shadow-sm">
          <svg id="iconAudioOn" class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15.536 8.464a5 5 0 010 7.072m2.828-9.9a9 9 0 010 12.728M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15z"/></svg>
          <svg id="iconAudioOff" class="w-4 h-4 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5.586 15H4a1 1 0 01-1-1v-4a1 1 0 011-1h1.586l4.707-4.707C10.923 3.663 12 4.109 12 5v14c0 .891-1.077 1.337-1.707.707L5.586 15zM17 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2"/></svg>
          <span id="labelAudio">BGM & SFX: Nyala</span>
        </button>

        <!-- Fullscreen Proyektor Button -->
        <button id="btnFullscreen" class="px-3 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition flex items-center gap-1" title="Layar Penuh Proyektor">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 8V4m0 0h4M4 4l5 5m11-5h-4m4 0v4m0 0l-5-5M4 16v4m0 0h4m-4 0l5-5m11 5l-5-5m5 5v-4m0 4h-4"/></svg>
          <span class="hidden md:inline">Proyektor</span>
        </button>
      </div>
    </div>
  </header>

  <!-- KONTEN UTAMA: PANGGUNG HITUNG PROYEKTOR -->
  <main class="max-w-6xl mx-auto w-full px-4 py-4 flex-grow flex flex-col items-center justify-center relative">
    
    <!-- LEVEL & PENGATURAN CEPAT DI ATAS STAGE -->
    <div id="quickControls" class="w-full max-w-3xl mb-4 bg-white/70 backdrop-blur-md rounded-2xl p-3 border border-indigo-100 shadow-sm flex flex-wrap items-center justify-between gap-3">
      
      <!-- Pemilih Level Khusus Siswa SD -->
      <div class="flex items-center gap-2">
        <label class="text-xs font-bold text-slate-500 uppercase tracking-wide">Tingkatan SD:</label>
        <select id="selectLevel" class="bg-indigo-50/80 border border-indigo-200 text-indigo-900 font-bold text-xs sm:text-sm rounded-xl px-3 py-1.5 focus:ring-2 focus:ring-indigo-400 focus:outline-none transition cursor-pointer">
          <option value="1">Level 1: Satuan Ceria 1-9 (Tangan Kanan Saja)</option>
          <option value="2">Level 2: Kawan Kecil 5 (Tangan Kanan)</option>
          <option value="3" selected>Level 3: Belasan 1-20 (Kawan Besar 10)</option>
          <option value="4">Level 4: Puluhan Pemula (Hasil 10 - 50)</option>
        </select>
      </div>

      <!-- Pengaturan Durasi & Jumlah Angka Ramah Siswa SD -->
      <div class="flex items-center gap-4 text-xs font-semibold text-slate-600">
        <div class="flex items-center gap-1.5">
          <span>Kecepatan:</span>
          <select id="selectSpeed" class="bg-rose-50 border border-rose-200 text-rose-800 rounded-lg px-2 py-1 font-bold">
            <option value="4000">4.0 detik (Sangat Santai)</option>
            <option value="3000" selected>3.0 detik (Standar SD)</option>
            <option value="2200">2.2 detik (Tangkas Cilik)</option>
            <option value="1500">1.5 detik (Tantangan Cepat)</option>
          </select>
        </div>

        <div class="flex items-center gap-1.5">
          <span>Jumlah Baris:</span>
          <select id="selectSteps" class="bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-lg px-2 py-1 font-bold">
            <option value="3">3 Angka</option>
            <option value="4" selected>4 Angka</option>
            <option value="5">5 Angka</option>
            <option value="6">6 Angka</option>
          </select>
        </div>
      </div>
    </div>

    <!-- AREA KARTU DISPLAY PROYEKTOR UTAMA -->
    <div class="w-full max-w-4xl bg-white/95 rounded-3xl shadow-2xl shadow-indigo-200/60 border-4 border-indigo-100 overflow-hidden relative flex flex-col justify-between transition-all duration-300 min-h-[480px]">
      
      <!-- Status Bar Layar Proyektor -->
      <div class="px-6 py-3.5 bg-gradient-to-r from-indigo-50 via-purple-50 to-rose-50 border-b border-indigo-100 flex items-center justify-between text-xs font-bold text-slate-600">
        <div class="flex items-center gap-2">
          <span id="badgeStatus" class="inline-flex items-center gap-1 px-3 py-1 rounded-full bg-slate-200 text-slate-700 font-bold">
            <span class="w-2 h-2 rounded-full bg-slate-500"></span> Siap Memulai
          </span>
          <span id="badgeTarget" class="text-slate-400 font-semibold hidden md:inline">| Mode: Jarimatika Dasar Ceria</span>
        </div>
        
        <!-- Step Progress Indicator -->
        <div id="stepCounterContainer" class="flex items-center gap-2">
          <span class="text-slate-400">Putaran:</span>
          <span id="stepCounterText" class="text-indigo-600 text-sm font-extrabold font-display">0 / 4</span>
        </div>
      </div>

      <!-- Garis Progres Waktu (Visual Timer Bar) -->
      <div class="w-full bg-slate-100 h-2.5 overflow-hidden">
        <div id="stepTimerBar" class="h-full bg-gradient-to-r from-indigo-400 via-rose-400 to-emerald-400 w-0 transition-none"></div>
      </div>

      <!-- LAYAR TENGAH: ANGKA RAKSASA (PROYEKTOR SCREEN) -->
      <div id="projectorCanvas" class="flex-grow flex flex-col items-center justify-center p-8 text-center select-none relative min-h-[300px]">
        
        <!-- 1. TAMPILAN STANDBY / IDLE -->
        <div id="screenIdle" class="flex flex-col items-center justify-center space-y-4 max-w-lg">
          <div class="w-20 h-20 rounded-full bg-pastel-lavender flex items-center justify-center text-indigo-600 shadow-inner">
            <svg class="w-10 h-10 animate-bounce-soft" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
          </div>
          <h2 class="text-2xl md:text-3xl font-extrabold text-slate-800 font-display">
            Ayo Siapkan Jarimu di Meja!
          </h2>
          <p class="text-slate-500 text-sm md:text-base leading-relaxed">
            👉 Tangan <strong>Kanan = Satuan (1–9)</strong> &bull; 👈 Tangan <strong>Kiri = Puluhan (10–50)</strong>.<br>
            Lihat angka di layar proyektor. Ikuti tanda plus (<span class="text-emerald-600 font-bold">+ Buka</span>) dan minus (<span class="text-rose-600 font-bold">- Lipat</span>)!
          </p>
          <button id="btnStart" class="mt-4 px-8 py-4 bg-gradient-to-r from-amber-500 via-rose-500 to-indigo-600 hover:from-amber-600 hover:to-indigo-700 text-white font-extrabold text-lg rounded-2xl shadow-lg shadow-indigo-300 transform hover:-translate-y-0.5 active:translate-y-0 transition flex items-center gap-3">
            <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM9.555 7.168A1 1 0 008 8v4a1 1 0 001.555.832l3-2a1 1 0 000-1.664l-3-2z" clip-rule="evenodd"/></svg>
            MULAI HITUNG JARIMATIKA
          </button>
        </div>

        <!-- 2. HITUNG MUNDUR (COUNTDOWN) -->
        <div id="screenCountdown" class="hidden flex-col items-center justify-center">
          <span class="text-indigo-400 text-xl font-bold tracking-widest uppercase mb-2">Bersiap...</span>
          <span id="countdownNumber" class="text-8xl md:text-9xl font-black font-display text-transparent bg-clip-text bg-gradient-to-br from-indigo-600 via-rose-500 to-amber-500 animate-pulse-fast">
            3
          </span>
          <span class="text-slate-400 text-sm mt-3 font-semibold">Tangan Kiri: Puluhan | Tangan Kanan: Satuan</span>
        </div>

        <!-- 3. ANGKA UTAMA BERJALAN (FLASH DISPLAY) -->
        <div id="screenFlash" class="hidden flex-col items-center justify-center w-full">
          <!-- Tanda Operasi (+ atau -) & Angka -->
          <div class="flex items-center justify-center gap-3 md:gap-6 my-2">
            <span id="displaySign" class="text-6xl md:text-8xl lg:text-9xl font-black transition-colors font-display">
              +
            </span>
            <span id="displayValue" class="text-7xl md:text-9xl lg:text-[11rem] font-black tracking-tight font-display text-slate-800 animate-pop-in drop-shadow-sm">
              25
            </span>
          </div>

          <!-- Petunjuk Visual Subtitusional Ramah Pemula -->
          <div id="subHint" class="mt-2 px-4 py-1 rounded-full bg-slate-100 text-slate-500 text-xs md:text-sm font-semibold tracking-wide">
            Operasikan pada kedua tangan!
          </div>
        </div>

        <!-- 4. MENUNGGU JAWABAN SISWA (LOCK IN ANSWER) -->
        <div id="screenAnswering" class="hidden flex-col items-center justify-center space-y-5 animate-pop-in">
          <div class="w-16 h-16 rounded-full bg-amber-100 text-amber-600 flex items-center justify-center font-bold text-3xl shadow-inner">
            ?
          </div>
          <div>
            <h3 class="text-3xl md:text-4xl font-extrabold text-slate-800 font-display mb-1">
              Kunci Formasi Jarimu!
            </h3>
            <p class="text-slate-500 text-base">Berapa angka puluhan dan satuan yang terbentuk pada kedua tanganmu?</p>
          </div>

          <!-- Pilihan Buka Kunci Jawaban -->
          <div class="flex flex-wrap items-center justify-center gap-3 pt-2">
            <button id="btnReveal" class="px-7 py-3.5 bg-emerald-500 hover:bg-emerald-600 text-white font-extrabold rounded-2xl shadow-lg shadow-emerald-200 transition transform hover:scale-105 active:scale-95 flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
              Buka Kunci Jawaban
            </button>
            <button id="btnRetry" class="px-5 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-2xl transition">
              Ulangi Soal Ini
            </button>
          </div>
        </div>

        <!-- 5. TAMPILAN JAWABAN AKHIR & ANALISIS JARI -->
        <div id="screenResult" class="hidden flex-col items-center justify-center space-y-4 animate-pop-in max-w-2xl w-full">
          <div class="text-xs font-bold text-emerald-600 uppercase tracking-widest bg-emerald-100 px-3 py-1 rounded-full">
            Hasil Akhir Mental Aritmatika
          </div>
          
          <div class="text-8xl md:text-9xl font-black font-display text-transparent bg-clip-text bg-gradient-to-r from-emerald-500 via-teal-600 to-indigo-600 drop-shadow-md">
            <span id="finalAnswerValue">00</span>
          </div>

          <!-- Visualisasi Bentuk Jari Kartun untuk Siswa SD -->
          <div class="w-full bg-slate-50 border border-slate-200 rounded-3xl p-4 text-center shadow-inner">
            <h4 class="text-xs font-extrabold text-slate-500 uppercase tracking-wider mb-3">
              Cocokkan Jarimu dengan Gambar di Layar:
            </h4>
            
            <div class="grid grid-cols-2 gap-4">
              <!-- Kartu Visual Tangan Kiri (Puluhan) -->
              <div class="p-3 bg-indigo-50/90 border border-indigo-100 rounded-2xl flex flex-col items-center">
                <span class="text-xs font-black text-indigo-600 mb-1.5 flex items-center gap-1">
                  👈 Tangan Kiri (Puluhan)
                </span>
                
                <!-- SVG Diagram Tangan Kiri -->
                <div id="visualLeftHand" class="flex items-end justify-center gap-1.5 h-24 my-2 px-3 py-2 bg-white rounded-xl border border-indigo-100 w-full max-w-[170px]">
                  <!-- Akan di-generate via JS: Jari Kelingking s.d Jempol -->
                </div>
                
                <span id="descLeftHand" class="text-xs text-indigo-800 font-bold mt-1">-</span>
              </div>

              <!-- Kartu Visual Tangan Kanan (Satuan) -->
              <div class="p-3 bg-rose-50/90 border border-rose-100 rounded-2xl flex flex-col items-center">
                <span class="text-xs font-black text-rose-600 mb-1.5 flex items-center gap-1">
                  👉 Tangan Kanan (Satuan)
                </span>

                <!-- SVG Diagram Tangan Kanan -->
                <div id="visualRightHand" class="flex items-end justify-center gap-1.5 h-24 my-2 px-3 py-2 bg-white rounded-xl border border-rose-100 w-full max-w-[170px]">
                  <!-- Akan di-generate via JS: Jempol s.d Kelingking -->
                </div>

                <span id="descRightHand" class="text-xs text-rose-800 font-bold mt-1">-</span>
              </div>
            </div>
          </div>

          <!-- Tombol Aksi Lanjut -->
          <div class="flex items-center gap-3 pt-2">
            <button id="btnNextRound" class="px-8 py-3.5 bg-indigo-600 hover:bg-indigo-700 text-white font-extrabold rounded-2xl shadow-lg shadow-indigo-200 transition transform hover:-translate-y-0.5">
              Lanjut Soal Berikutnya &rarr;
            </button>
            <button id="btnToggleBreakdown" class="px-4 py-3.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded-2xl text-xs">
              Lihat Riwayat Angka
            </button>
          </div>
        </div>

      </div>

      <!-- FOOTER CONTROL BAR (KONTROL GURU / COACH SAAT BERJALAN) -->
      <div class="px-6 py-3 bg-slate-50 border-t border-indigo-50 flex items-center justify-between text-xs text-slate-500">
        <div class="flex items-center gap-2">
          <button id="btnStop" class="px-3 py-1.5 rounded-lg bg-slate-200 hover:bg-rose-100 hover:text-rose-700 font-bold transition disabled:opacity-40" disabled>
            Hentikan / Reset
          </button>
          <span class="text-slate-400">|</span>
          <span id="coachTip" class="italic text-slate-500 hidden sm:inline">
            "Ingat rumus kawan 5 SD: Buka jempol (5), lalu lipat kawan temannya!"
          </span>
        </div>

        <div class="text-right">
          <span class="font-semibold text-slate-400">Tingkat:</span>
          <span class="font-bold text-amber-600">SD / MI Dasar</span>
        </div>
      </div>
    </div>

    <!-- PANEL BREAKDOWN LANGKAH (Bisa di-toggle untuk verifikasi kelas) -->
    <div id="breakdownPanel" class="w-full max-w-4xl mt-4 bg-white/90 rounded-2xl p-4 border border-slate-200 shadow-sm hidden">
      <div class="flex items-center justify-between mb-2">
        <h4 class="text-xs font-black uppercase tracking-wider text-slate-700">Rincian Hitungan Setiap Baris:</h4>
        <span class="text-[11px] text-slate-400">Verifikasi bersama siswa</span>
      </div>
      <div id="breakdownList" class="flex flex-wrap items-center gap-2 text-sm font-semibold">
        <!-- Akan diisi lewat JS: Contoh badge "+25 -> -12 -> +30 = 43" -->
      </div>
    </div>
  </main>

  <!-- FOOTER DEVELOPER & KREDIT -->
  <footer class="w-full py-3 bg-white/60 backdrop-blur-sm border-t border-indigo-50 text-center text-xs text-slate-500">
    <div class="max-w-7xl mx-auto px-4 flex flex-col sm:flex-row items-center justify-between gap-1 font-medium">
      <div>
        Aplikasi Penguji Mental Aritmatika &bull; Dirancang untuk Proyektor Pembelajaran SMA
      </div>
      <div class="font-semibold text-slate-700">
        Pengembang: <span class="text-indigo-600 font-bold">Rahmat Djafar, S.Pd., Gr.</span>
      </div>
    </div>
  </footer>

  <!-- MODAL PANDUAN DASAR JARIMATIKA (POPUP EDUKASI) -->
  <div id="modalGuide" class="fixed inset-0 bg-slate-900/40 backdrop-blur-sm z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-3xl max-w-2xl w-full p-6 shadow-2xl border border-indigo-100 max-h-[90vh] overflow-y-auto">
      <div class="flex items-center justify-between border-b border-slate-100 pb-3 mb-4">
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-lg bg-indigo-100 text-indigo-700 flex items-center justify-center font-bold text-lg">✋</div>
          <h3 class="text-lg font-black text-slate-800 font-display">Panduan Jarimatika Ceria (Siswa SD)</h3>
        </div>
        <button id="btnCloseGuide" class="text-slate-400 hover:text-slate-600 p-1.5 rounded-xl hover:bg-slate-100">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
        </button>
      </div>

      <div class="space-y-4 text-xs md:text-sm text-slate-600 leading-relaxed">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-3">
          <!-- Tangan Kanan Satuan Dulu (Fokus Utama SD) -->
          <div class="p-3.5 bg-rose-50/80 border border-rose-100 rounded-2xl">
            <span class="font-extrabold text-rose-700 block text-sm mb-1">👉 TANGAN KANAN = SATUAN (1 - 9)</span>
